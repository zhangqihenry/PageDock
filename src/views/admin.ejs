<!doctype html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> · PageDock</title>
    <script src="/_pagedock/assets/theme-init.js"></script>
    <script src="/_pagedock/assets/theme.js" defer></script>
    <link rel="stylesheet" href="/_pagedock/assets/admin.css">
  </head>
  <body>
    <header class="bar">
      <a class="mark" href="/"><img class="mark-logo" src="/_pagedock/assets/logo.png" alt="PageDock"></a>
      <div class="bar-actions">
        <%- include('partials/toggles') %>
        <a class="btn" href="/"><%= t('nav.backToCatalog') %></a>
        <form action="/_pagedock/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit"><%= t('nav.logout') %></button>
        </form>
      </div>
    </header>

    <main class="wrap">
      <% if (message) { %>
        <div class="alert alert-success" role="status"><%= message %></div>
      <% } %>

      <section class="panel">
        <div class="panel-heading">
          <h2><%= t('admin.uploadHeading') %></h2>
          <p class="muted">
            <%= t('admin.limits', {
              upload: limits.upload,
              extracted: limits.extracted,
              files: limits.files,
            }) %>
          </p>
        </div>

        <form
          action="/_pagedock/upload"
          method="post"
          enctype="multipart/form-data"
          class="upload-grid"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>
            <%= t('form.titleLabel') %>
            <input
              name="title"
              maxlength="100"
              placeholder="<%= t('form.titlePlaceholder') %>"
              required
            >
          </label>
          <label>
            <%= t('form.pathLabel') %>
            <input
              name="pathId"
              pattern="[A-Za-z0-9_-]{1,64}"
              maxlength="64"
              placeholder="<%= t('form.pathPlaceholder') %>"
              required
            >
          </label>
          <label>
            <%= t('form.fileLabel') %>
            <input name="siteFile" type="file" accept=".html,.zip" required>
          </label>
          <label>
            <%= t('form.versionLabel') %>
            <input
              name="version"
              maxlength="40"
              placeholder="<%= t('form.versionPlaceholder') %>"
            >
          </label>
          <label class="field-wide">
            <%= t('common.description') %>
            <textarea
              name="description"
              maxlength="300"
              rows="3"
              placeholder="<%= t('form.descriptionPlaceholder') %>"
            ></textarea>
          </label>
          <fieldset>
            <legend><%= t('form.overwriteLegend') %></legend>
            <label class="radio-option">
              <input type="radio" name="overwrite" value="false" checked>
              <%= t('form.overwriteCancel') %>
            </label>
            <label class="radio-option">
              <input type="radio" name="overwrite" value="true">
              <%= t('form.overwriteReplace') %>
            </label>
          </fieldset>
          <button type="submit" class="btn-solid"><%= t('nav.upload') %></button>
        </form>
      </section>

      <section class="panel">
        <div class="panel-heading">
          <h2><%= t('admin.sitesHeading') %></h2>
          <p class="muted"><%= t('catalog.tally', { count: sites.length }) %></p>
        </div>

        <% if (sites.length === 0) { %>
          <div class="empty">
            <p><%= t('admin.emptyState') %></p>
          </div>
        <% } else { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th><%= t('table.title') %></th>
                  <th><%= t('table.path') %></th>
                  <th><%= t('common.description') %></th>
                  <th><%= t('table.version') %></th>
                  <th><%= t('table.uploadedAt') %></th>
                  <th><%= t('table.size') %></th>
                  <th><span class="sr-only"><%= t('table.actions') %></span></th>
                </tr>
              </thead>
              <tbody>
                <% for (const site of sites) { %>
                  <tr>
                    <td><%= site.title %></td>
                    <td><code>/<%= site.pathId %>/</code></td>
                    <td class="description-cell"><%= site.description || t('common.noDescription') %></td>
                    <td><%= site.version || t('common.noVersion') %></td>
                    <td><%= site.formattedDate %></td>
                    <td><%= site.formattedSize %></td>
                    <td class="actions">
                      <a class="btn" href="/<%= site.pathId %>/" target="_blank" rel="noopener">
                        <%= t('table.open') %>
                      </a>
                      <form action="/_pagedock/sites/<%= site.pathId %>/delete" method="post">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn-danger" type="submit"><%= t('table.delete') %></button>
                      </form>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </main>
  </body>
</html>
