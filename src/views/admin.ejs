<!doctype html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> · PageDock</title>
    <script src="/_pagedock/assets/theme-init.js?v=<%= assetVersion %>"></script>
    <script src="/_pagedock/assets/theme.js?v=<%= assetVersion %>" defer></script>
    <link rel="stylesheet" href="/_pagedock/assets/admin.css?v=<%= assetVersion %>">
  </head>
  <body>
    <header class="bar">
      <a class="mark" href="/"><img class="mark-logo" src="/_pagedock/assets/logo.png?v=<%= assetVersion %>" alt="PageDock"></a>
      <div class="bar-actions">
        <%- include('partials/toggles') %>
        <a class="btn" href="/"><%= t('nav.backToCatalog') %></a>
        <form action="/_pagedock/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit"><%= t('nav.logout') %></button>
        </form>
      </div>
    </header>

    <main class="wrap">
      <% if (message) { %>
        <div class="alert alert-success" role="status"><%= message %></div>
      <% } %>

      <section class="panel">
        <div class="panel-heading">
          <h2><%= t('admin.uploadHeading') %></h2>
          <p class="muted">
            <%= t('admin.limits', {
              upload: limits.upload,
              extracted: limits.extracted,
              files: limits.files,
            }) %>
          </p>
        </div>

        <form
          action="/_pagedock/upload"
          method="post"
          enctype="multipart/form-data"
          class="upload-grid"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>
            <%= t('form.titleLabel') %>
            <input
              name="title"
              maxlength="100"
              placeholder="<%= t('form.titlePlaceholder') %>"
              required
            >
          </label>
          <label>
            <%= t('form.pathLabel') %>
            <input
              name="pathId"
              pattern="[A-Za-z0-9_-]{1,64}"
              maxlength="64"
              placeholder="<%= t('form.pathPlaceholder') %>"
              required
            >
          </label>
          <label>
            <%= t('form.fileLabel') %>
            <input name="siteFile" type="file" accept=".html,.zip" required>
          </label>
          <label>
            <%= t('form.versionLabel') %>
            <input
              name="version"
              maxlength="40"
              placeholder="<%= t('form.versionPlaceholder') %>"
            >
          </label>
          <label class="field-wide">
            <%= t('common.description') %>
            <textarea
              name="description"
              maxlength="300"
              rows="3"
              placeholder="<%= t('form.descriptionPlaceholder') %>"
            ></textarea>
          </label>
          <fieldset>
            <legend><%= t('form.overwriteLegend') %></legend>
            <label class="radio-option">
              <input type="radio" name="overwrite" value="false" checked>
              <%= t('form.overwriteCancel') %>
            </label>
            <label class="radio-option">
              <input type="radio" name="overwrite" value="true">
              <%= t('form.overwriteReplace') %>
            </label>
          </fieldset>
          <button type="submit" class="btn-solid"><%= t('nav.upload') %></button>
        </form>
      </section>

      <section class="panel">
        <div class="panel-heading">
          <div>
            <h2><%= t('admin.sitesHeading') %></h2>
            <p class="muted"><%= t('catalog.tally', { count: sites.length }) %></p>
          </div>
          <% if (sites.length > 0) { %>
            <button form="sort-order-form" type="submit" class="btn-solid">
              <%= t('table.saveOrder') %>
            </button>
          <% } %>
        </div>

        <% if (sites.length === 0) { %>
          <div class="empty">
            <p><%= t('admin.emptyState') %></p>
          </div>
        <% } else { %>
          <form id="sort-order-form" action="/_pagedock/sites/sort-order" method="post" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          </form>
          <div class="table-wrap">
            <table class="admin-sites-table">
              <colgroup>
                <col class="site-title-column">
                <col class="site-description-column">
                <col class="site-meta-column">
                <col class="site-order-column">
                <col class="site-actions-column">
              </colgroup>
              <thead>
                <tr>
                  <th><%= t('table.title') %></th>
                  <th><%= t('common.description') %></th>
                  <th><%= t('table.details') %></th>
                  <th><%= t('table.sortOrder') %></th>
                  <th><span class="sr-only"><%= t('table.actions') %></span></th>
                </tr>
              </thead>
              <tbody>
                <% for (const site of sites) { %>
                  <tr class="<%= site.enabled ? '' : 'site-disabled' %>">
                    <td class="site-title-cell">
                      <strong><%= site.title %></strong>
                      <code class="site-subline">/<%= site.pathId %>/</code>
                      <span class="site-status <%= site.enabled ? 'is-enabled' : 'is-disabled' %>">
                        <%= t(site.enabled ? 'table.enabledStatus' : 'table.disabledStatus') %>
                      </span>
                    </td>
                    <td class="description-cell"><%= site.description || t('common.noDescription') %></td>
                    <td class="site-meta-cell">
                      <span><%= site.version || t('common.noVersion') %></span>
                      <span><%= site.formattedDate %></span>
                      <span><%= site.formattedSize %></span>
                    </td>
                    <td class="site-order-cell">
                      <input type="hidden" form="sort-order-form" name="pathId" value="<%= site.pathId %>">
                      <input
                        form="sort-order-form"
                        class="site-order-input"
                        name="sortOrder"
                        type="number"
                        min="0"
                        step="1"
                        inputmode="numeric"
                        value="<%= site.sortOrder %>"
                        aria-label="<%= t('table.sortOrder') %>"
                      >
                    </td>
                    <td class="actions">
                      <% if (site.enabled) { %>
                        <a class="btn" href="/<%= site.pathId %>/" target="_blank" rel="noopener">
                          <%= t('table.open') %>
                        </a>
                      <% } else { %>
                        <span class="btn btn-disabled" aria-disabled="true"><%= t('table.open') %></span>
                      <% } %>
                      <a class="btn" href="/_pagedock/sites/<%= site.pathId %>/edit">
                        <%= t('table.edit') %>
                      </a>
                      <form action="/_pagedock/sites/<%= site.pathId %>/visibility" method="post">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="enabled" value="<%= site.enabled ? 'false' : 'true' %>">
                        <button type="submit"><%= t(site.enabled ? 'table.disable' : 'table.enable') %></button>
                      </form>
                      <form action="/_pagedock/sites/<%= site.pathId %>/delete" method="post">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn-danger" type="submit"><%= t('table.delete') %></button>
                      </form>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </main>
  </body>
</html>
