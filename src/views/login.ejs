<!doctype html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> · PageDock</title>
    <script src="/_pagedock/assets/theme-init.js?v=<%= assetVersion %>"></script>
    <script src="/_pagedock/assets/theme.js?v=<%= assetVersion %>" defer></script>
    <link rel="stylesheet" href="/_pagedock/assets/admin.css?v=<%= assetVersion %>">
  </head>
  <body class="login-page">
    <main class="login-card">
      <div class="login-card-tools">
        <%- include('partials/toggles') %>
      </div>
      <a class="mark" href="/"><img class="mark-logo" src="/_pagedock/assets/logo.png?v=<%= assetVersion %>" alt="PageDock"></a>
      <p class="muted"><%= t('login.subtitle') %></p>

      <% if (error) { %>
        <div class="alert alert-error" role="alert"><%= error %></div>
      <% } %>

      <form action="/_pagedock/login" method="post" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>
          <%= t('login.usernameLabel') %>
          <input name="username" autocomplete="username" required autofocus>
        </label>
        <label>
          <%= t('login.passwordLabel') %>
          <input type="password" name="password" autocomplete="current-password" required>
        </label>
        <button type="submit" class="btn-solid btn-full"><%= t('login.submit') %></button>
      </form>
      <a class="text-link login-back-link" href="/"><%= t('login.backLink') %></a>
    </main>
  </body>
</html>
