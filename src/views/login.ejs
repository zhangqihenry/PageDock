<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> · PageDock</title>
    <link rel="stylesheet" href="/_pagedock/assets/admin.css">
  </head>
  <body class="login-page">
    <main class="login-card">
      <p class="eyebrow">WEB PAGE MANAGEMENT</p>
      <h1>PageDock</h1>
      <p class="muted">登录后上传和管理网页。</p>

      <% if (error) { %>
        <div class="alert alert-error" role="alert"><%= error %></div>
      <% } %>

      <form action="/_pagedock/login" method="post" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>
          管理员账号
          <input name="username" autocomplete="username" required autofocus>
        </label>
        <label>
          管理员密码
          <input type="password" name="password" autocomplete="current-password" required>
        </label>
        <button type="submit">登录</button>
      </form>
      <a class="text-link login-back-link" href="/">返回网页目录</a>
    </main>
  </body>
</html>
