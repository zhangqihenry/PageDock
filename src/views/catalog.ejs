<!doctype html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> · PageDock</title>
    <meta
      name="description"
      content="<%= t('meta.description') %>"
    >
    <script src="/_pagedock/assets/theme-init.js"></script>
    <script src="/_pagedock/assets/theme.js" defer></script>
    <link rel="stylesheet" href="/_pagedock/assets/admin.css">
  </head>
  <body>
    <header class="bar">
      <a class="mark" href="/"><img class="mark-logo" src="/_pagedock/assets/logo.png" alt="PageDock"></a>
      <div class="bar-actions">
        <%- include('partials/toggles') %>
        <a class="btn" href="<%= adminUrl %>"><%= t('nav.upload') %></a>
      </div>
    </header>

    <main class="wrap">
      <section class="intro">
        <h1><%= t('catalog.title') %></h1>
        <p class="lede"><%= t('catalog.lede') %></p>
        <p class="tally"><%= t('catalog.tally', { count: sites.length }) %></p>
      </section>

      <% if (sites.length === 0) { %>
        <section class="empty">
          <p><%= t('catalog.empty') %></p>
        </section>
      <% } else { %>
        <section class="list" aria-label="<%= t('catalog.listLabel') %>">
          <% sites.forEach(function (site, index) { %>
            <a class="row" href="/<%= site.pathId %>/" target="_blank" rel="noopener">
              <span class="row-index"><%= String(index + 1).padStart(2, '0') %></span>
              <span class="row-main">
                <span class="row-title"><%= site.title %></span>
                <span class="row-desc"><%= site.description || t('common.noDescription') %></span>
                <span class="row-meta">
                  <% if (site.version) { %>
                    <span class="mono"><%= t('common.versionTag', { version: site.version }) %></span>
                  <% } %>
                  <span><%= site.formattedDate %></span>
                </span>
              </span>
              <span class="row-path mono">/<%= site.pathId %>/</span>
              <span class="row-open"><%= t('catalog.open') %></span>
            </a>
          <% }); %>
        </section>
      <% } %>
    </main>
  </body>
</html>
