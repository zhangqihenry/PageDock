<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> · PageDock</title>
    <meta
      name="description"
      content="PageDock 网页目录，集中浏览和打开已发布的网页。"
    >
    <link rel="stylesheet" href="/_pagedock/assets/admin.css">
  </head>
  <body>
    <header class="topbar catalog-topbar">
      <div>
        <p class="eyebrow">SHARED WEB PAGES</p>
        <h1>PageDock</h1>
      </div>
      <a class="button-link" href="<%= adminUrl %>">上传网页</a>
    </header>

    <main class="container catalog-container">
      <section class="catalog-intro">
        <div>
          <p class="eyebrow">CATALOG</p>
          <h2>网页目录</h2>
          <p class="muted">浏览已经发布的网页，点击打开将在新窗口中显示。</p>
        </div>
        <span class="count"><%= sites.length %></span>
      </section>

      <% if (sites.length === 0) { %>
        <section class="panel empty-state catalog-empty">
          <h3>目录暂时为空</h3>
          <p>点击右上角“上传网页”发布第一个网页。</p>
        </section>
      <% } else { %>
        <section class="catalog-grid" aria-label="已发布网页">
          <% for (const site of sites) { %>
            <article class="site-card">
              <div class="site-card-body">
                <p class="site-path">/<%= site.pathId %>/</p>
                <h3><%= site.pathId %></h3>
                <p class="site-description">
                  <%= site.description || '暂无说明' %>
                </p>
              </div>
              <a
                class="button-link site-open-button"
                href="/<%= site.pathId %>/"
                target="_blank"
                rel="noopener"
              >
                打开网页
              </a>
            </article>
          <% } %>
        </section>
      <% } %>
    </main>
  </body>
</html>
