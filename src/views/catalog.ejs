<!doctype html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> · PageDock</title>
    <meta
      name="description"
      content="<%= t('meta.description') %>"
    >
    <script src="/_pagedock/assets/theme-init.js?v=<%= assetVersion %>"></script>
    <script src="/_pagedock/assets/theme.js?v=<%= assetVersion %>" defer></script>
    <link rel="stylesheet" href="/_pagedock/assets/admin.css?v=<%= assetVersion %>">
  </head>
  <body>
    <header class="bar">
      <a class="mark" href="/"><img class="mark-logo" src="/_pagedock/assets/logo.png?v=<%= assetVersion %>" alt="PageDock"></a>
      <div class="bar-actions">
        <a
          class="version-tag mono"
          href="https://github.com/zhangqihenry/PageDock/releases/tag/v<%= assetVersion %>"
          target="_blank"
          rel="noopener noreferrer"
          title="<%= t('nav.versionLabel', { version: assetVersion }) %>"
        >v<%= assetVersion %></a>
        <a
          class="icon-button"
          href="https://github.com/zhangqihenry"
          target="_blank"
          rel="noopener noreferrer"
          title="<%= t('nav.githubProfile') %>"
          aria-label="<%= t('nav.githubProfile') %>"
        >
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .5C5.73.5.98 5.24.98 11.52c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.17.69-3.84-1.35-3.84-1.35-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.75 2.68 1.24 3.33.95.1-.74.4-1.24.72-1.53-2.53-.29-5.19-1.27-5.19-5.63 0-1.24.44-2.26 1.17-3.06-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.14 1.17a10.9 10.9 0 0 1 5.72 0c2.18-1.48 3.14-1.17 3.14-1.17.62 1.57.23 2.73.11 3.02.73.8 1.17 1.82 1.17 3.06 0 4.37-2.66 5.34-5.2 5.62.41.36.77 1.06.77 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.2.66.79.55 4.51-1.5 7.77-5.76 7.77-10.78C23.02 5.24 18.27.5 12 .5Z"></path>
          </svg>
        </a>
        <%- include('partials/toggles') %>
        <a class="btn" href="<%= adminUrl %>"><%= t('nav.upload') %></a>
      </div>
    </header>

    <main class="wrap">
      <section class="intro">
        <h1><%= t('catalog.title') %></h1>
        <p class="lede"><%= t('catalog.lede') %></p>
        <p class="tally"><%= t('catalog.tally', { count: sites.length }) %></p>
      </section>

      <% if (sites.length === 0) { %>
        <section class="empty">
          <p><%= t('catalog.empty') %></p>
        </section>
      <% } else { %>
        <section class="list" aria-label="<%= t('catalog.listLabel') %>">
          <% sites.forEach(function (site, index) { %>
            <a class="row" href="/<%= site.pathId %>/" target="_blank" rel="noopener">
              <span class="row-index"><%= String(index + 1).padStart(2, '0') %></span>
              <span class="row-main">
                <span class="row-title"><%= site.title %></span>
                <span class="row-desc"><%= site.description || t('common.noDescription') %></span>
                <span class="row-meta">
                  <% if (site.version) { %>
                    <span class="mono"><%= t('common.versionTag', { version: site.version }) %></span>
                  <% } %>
                  <span><%= site.formattedDate %></span>
                </span>
              </span>
              <span class="row-path mono">/<%= site.pathId %>/</span>
              <span class="row-open"><%= t('catalog.open') %></span>
            </a>
          <% }); %>
        </section>
      <% } %>
    </main>
  </body>
</html>
