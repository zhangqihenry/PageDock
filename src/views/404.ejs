<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> · PageDock</title>
    <style>
      :root { color-scheme: dark; font-family: system-ui, sans-serif; }
      body { min-height: 100vh; margin: 0; display: grid; place-items: center; background: #101418; color: #f4f7f9; }
      main { max-width: 34rem; padding: 2rem; text-align: center; }
      strong { display: block; font-size: clamp(5rem, 20vw, 10rem); line-height: .9; color: #66d9c2; }
      p { color: #aab7c2; }
    </style>
  </head>
  <body>
    <main>
      <strong>404</strong>
      <h1><%= title %></h1>
      <p><%= message %></p>
    </main>
  </body>
</html>
