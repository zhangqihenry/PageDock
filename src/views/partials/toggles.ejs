<button type="button" class="icon-button" data-theme-toggle aria-label="<%= t('nav.toggleTheme') %>">
  <svg class="icon-sun" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
  </svg>
</button>
<a
  class="icon-button lang-toggle"
  href="?lang=<%= lang === 'en' ? 'zh' : 'en' %>"
  aria-label="<%= lang === 'en' ? '切换到中文' : 'Switch to English' %>"
><%= lang === 'en' ? '中' : 'EN' %></a>
